# Frontend
VITE_API_MODE=mysql
# Deprecated compatibility fallback for older releases:
# VITE_BACKEND_PROVIDER=php
VITE_API_URL=/api
VITE_ERROR_TELEMETRY_ENDPOINT=
VITE_APP_VERSION=0.2.0

# Vercel Node API
APP_DEBUG=false
DB_HOST=your-mysql-host
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
DB_CONNECTION_LIMIT=5
DB_MAX_IDLE_CONNECTIONS=1
DB_IDLE_TIMEOUT_MS=60000
DB_QUERY_TIMEOUT_MS=8000
# Many cloud MySQL providers need SSL.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_TTL_SECONDS=86400
SUPER_ADMIN_SECRET=replace_with_a_long_random_bootstrap_secret
CORS_ORIGIN=https://your-vercel-domain.vercel.app
FRONTEND_URL=https://your-vercel-domain.vercel.app
UPLOAD_MAX_BYTES=5242880
# Optional JSON webhook for threshold alerts. Keep server-side only.
ALERT_WEBHOOK_URL=

# Required for /api/uploads/*
# Create Vercel Blob storage and copy its read/write token here.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token

# Local/test seed only. Never push these variables to Vercel.
# Required only with: npm run db:import:mysql -- --seed
DEMO_SUPER_ADMIN_PASSWORD=replace_with_a_unique_random_password_of_16_or_more_chars
DEMO_SCHOOL_ADMIN_PASSWORD=replace_with_another_unique_random_password_of_16_or_more_chars
