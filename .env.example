# Supabase Configuration
# Copy this file to .env and fill in your actual values

# Supabase Project URL
# Get this from your Supabase project settings: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Public Key
# Get this from your Supabase project settings: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Error Telemetry Configuration (Optional)
# Error telemetry endpoint for production error tracking
# This should be your backend endpoint for receiving error reports
# Format: https://your-domain.com/api/errors
# Leave empty to disable production error telemetry (errors will still be logged to console)
VITE_ERROR_TELEMETRY_ENDPOINT=

# Application Version (Optional)
# Version number for tracking errors by release
VITE_APP_VERSION=0.0.1

# Note: Never commit your actual .env file to version control
# The .env file should be listed in .gitignore
