{
  "version": "1.3.0",
  "primaryBackend": "node",
  "basePath": "/api",
  "requestIdHeader": "X-Request-ID",
  "envelopes": {
    "success": { "required": ["data"] },
    "error": { "required": ["error"], "errorRequired": ["message"] },
    "health": { "required": ["ok", "service", "checks", "time"] }
  },
  "endpoints": [
    { "path": "/health", "methods": ["GET"], "auth": false, "envelope": "health" },
    { "path": "/auth/login", "methods": ["POST"], "auth": false, "envelope": "success" },
    { "path": "/auth/register", "methods": ["POST"], "auth": false, "envelope": "success" },
    { "path": "/auth/register-school", "methods": ["POST"], "auth": false, "envelope": "success" },
    { "path": "/auth/me", "methods": ["GET"], "auth": true, "envelope": "success" },
    { "path": "/auth/teacher-application", "methods": ["POST"], "auth": true, "envelope": "success" },
    { "path": "/auth/profile", "methods": ["PATCH"], "auth": true, "envelope": "success" },
    { "path": "/auth/change-password", "methods": ["POST"], "auth": true, "envelope": "success" },
    { "path": "/auth/request-password-reset", "methods": ["POST"], "auth": false, "envelope": "success" },
    { "path": "/auth/reset-password", "methods": ["POST"], "auth": false, "envelope": "success" },
    { "path": "/auth/teacher-portal-link", "methods": ["POST"], "auth": true, "envelope": "success" },
    { "path": "/auth/teacher-portal-login", "methods": ["POST"], "auth": false, "envelope": "success" },
    { "path": "/auth/logout", "methods": ["POST"], "auth": true, "envelope": "success" },
    { "path": "/bootstrap/status", "methods": ["GET"], "auth": false, "envelope": "success" },
    { "path": "/bootstrap/create-super-admin", "methods": ["POST"], "auth": false, "envelope": "success" },
    { "path": "/public/schools", "methods": ["GET"], "auth": false, "envelope": "success" },
    { "path": "/tables/{table}", "methods": ["GET", "POST"], "auth": true, "envelope": "success" },
    { "path": "/tables/{table}/count", "methods": ["GET"], "auth": true, "envelope": "success" },
    { "path": "/tables/{table}/{id}", "methods": ["GET", "PATCH", "DELETE"], "auth": true, "envelope": "success" },
    { "path": "/academic/bulk-enroll", "methods": ["POST"], "auth": true, "envelope": "success" },
    { "path": "/academic/promote", "methods": ["POST"], "auth": true, "envelope": "success" },
    { "path": "/academic/admissions/{id}/accept", "methods": ["POST"], "auth": true, "envelope": "success" },
    { "path": "/academic/guardian-invitations", "methods": ["POST"], "auth": true, "envelope": "success" },
    { "path": "/academic/accept-guardian-invitation", "methods": ["POST"], "auth": true, "envelope": "success" },
    { "path": "/billing/invoices/generate", "methods": ["POST"], "auth": true, "envelope": "success" },
    { "path": "/billing/invoices/{id}/adjustments", "methods": ["POST"], "auth": true, "envelope": "success" },
    { "path": "/billing/payments", "methods": ["POST"], "auth": true, "envelope": "success" },
    { "path": "/uploads/{bucket}", "methods": ["POST"], "auth": true, "envelope": "success" }
  ],
  "tables": {
    "allowed": [
      "schools", "user_profiles", "user_roles", "classes", "students",
      "subjects", "teachers", "attendance", "exams", "exam_results",
      "timetable", "teacher_applications", "audit_logs", "system_settings",
      "notifications", "notification_settings", "feedback_submissions",
      "academic_years", "academic_terms", "student_enrollments", "guardian_relationships",
      "admission_applications", "class_offerings", "subject_offerings",
      "assessment_categories", "grading_scales", "grading_scale_bands",
      "assessments", "assessment_scores", "report_cards", "report_card_items",
      "guardian_invitations", "fee_categories", "fee_plans", "fee_plan_items",
      "student_invoices", "student_invoice_items", "payments", "payment_allocations",
      "invoice_adjustments"
    ],
    "schoolScoped": [
      "classes", "students", "subjects", "teachers", "attendance", "exams",
      "exam_results", "timetable", "teacher_applications", "audit_logs",
      "notifications", "notification_settings", "feedback_submissions",
      "academic_years", "academic_terms", "student_enrollments", "guardian_relationships",
      "admission_applications", "class_offerings", "subject_offerings",
      "assessment_categories", "grading_scales", "grading_scale_bands",
      "assessments", "assessment_scores", "report_cards", "report_card_items",
      "guardian_invitations", "fee_categories", "fee_plans", "fee_plan_items",
      "student_invoices", "student_invoice_items", "payments", "payment_allocations",
      "invoice_adjustments"
    ]
  },
  "authorization": {
    "super_admin": {
      "all": ["read", "create", "update", "delete"],
      "overrides": {
        "audit_logs": ["read", "create"],
        "student_invoices": ["read"],
        "student_invoice_items": ["read"],
        "payments": ["read"],
        "payment_allocations": ["read"],
        "invoice_adjustments": ["read"]
      }
    },
    "school_admin": {
      "read": [
        "schools", "user_profiles", "classes", "students", "subjects", "teachers",
        "attendance", "exams", "exam_results", "timetable", "teacher_applications",
        "audit_logs", "notifications", "notification_settings", "feedback_submissions",
        "academic_years", "academic_terms", "student_enrollments", "guardian_relationships",
        "admission_applications", "class_offerings", "subject_offerings",
        "assessment_categories", "grading_scales", "grading_scale_bands",
        "assessments", "assessment_scores", "report_cards", "report_card_items",
        "guardian_invitations", "fee_categories", "fee_plans", "fee_plan_items",
        "student_invoices", "student_invoice_items", "payments", "payment_allocations",
        "invoice_adjustments"
      ],
      "write": [
        "user_profiles", "classes", "students", "subjects", "teachers", "attendance",
        "exams", "exam_results", "timetable", "teacher_applications", "notifications",
        "notification_settings", "feedback_submissions", "academic_years", "academic_terms",
        "student_enrollments", "guardian_relationships", "admission_applications",
        "class_offerings", "subject_offerings", "assessment_categories",
        "grading_scales", "grading_scale_bands", "assessments", "assessment_scores",
        "report_cards", "report_card_items", "fee_categories", "fee_plans", "fee_plan_items"
      ],
      "appendOnly": ["audit_logs"]
    },
    "teacher": {
      "read": [
        "schools", "user_profiles", "classes", "students", "subjects", "teachers",
        "attendance", "exams", "exam_results", "timetable", "teacher_applications",
        "notifications", "notification_settings", "feedback_submissions",
        "academic_years", "academic_terms", "student_enrollments",
        "class_offerings", "subject_offerings", "assessment_categories",
        "grading_scales", "grading_scale_bands", "assessments", "assessment_scores",
        "report_cards", "report_card_items"
      ],
      "write": [
        "attendance", "exam_results", "notification_settings", "feedback_submissions",
        "assessments", "assessment_scores", "report_cards", "report_card_items"
      ],
      "appendOnly": ["audit_logs"]
    },
    "student": {
      "read": [
        "schools", "user_profiles", "students", "notifications", "notification_settings",
        "feedback_submissions", "academic_years", "academic_terms",
        "student_enrollments", "guardian_relationships", "assessment_scores",
        "report_cards", "report_card_items", "student_invoices", "student_invoice_items",
        "payments", "payment_allocations"
      ],
      "write": ["notification_settings", "feedback_submissions"]
    },
    "guardian": {
      "read": [
        "schools", "user_profiles", "students", "notifications", "notification_settings",
        "feedback_submissions", "academic_years", "academic_terms",
        "student_enrollments", "guardian_relationships", "assessment_scores",
        "report_cards", "report_card_items", "student_invoices", "student_invoice_items",
        "payments", "payment_allocations"
      ],
      "write": ["notification_settings", "feedback_submissions"]
    }
  },
  "intentionalDifferences": [
    {
      "area": "uploads",
      "node": "Vercel Blob object storage",
      "php": "Hosting filesystem storage",
      "sharedGuarantee": "Authenticated upload, identical bucket and MIME allowlists, public URL response"
    },
    {
      "area": "request_id_body",
      "node": "Request ID is guaranteed in the response header",
      "php": "Request ID is in the response header and additionally in JSON bodies",
      "sharedGuarantee": "X-Request-ID header on every application response"
    },
    {
      "area": "deployment",
      "node": "Primary production backend on Vercel",
      "php": "Compatibility backend for shared hosting",
      "sharedGuarantee": "Contract tests must pass before release"
    },
    {
      "area": "client_error_telemetry",
      "node": "Accepts sanitized browser error batches at /telemetry/errors",
      "php": "Relies on host-level PHP logging and alerting",
      "sharedGuarantee": "Request IDs correlate client failures with sanitized server logs"
    }
  ]
}
